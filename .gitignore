# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
venv/
.venv/
.venv_build/
env/

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# Pytest cache
.pytest_cache/
.coverage

# IDE
.vscode/
.idea/
*.swp

# Session data (user-generated, not tracked)
data/sessions/*.json
data/actions.json
# But always keep the placeholder files so git tracks the empty dirs
!data/.gitkeep
!data/sessions/.gitkeep

# Build log
build_log.txt
